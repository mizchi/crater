{
  "name": "crater",
  "version": "0.10.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "release:moon:list": "node scripts/moon-publish-workspace.mjs --list",
    "release:moon:check": "node scripts/moon-publish-workspace.mjs --check",
    "release:moon:dry-run": "node scripts/moon-publish-workspace.mjs --dry-run",
    "release:moon:publish": "node scripts/moon-publish-workspace.mjs --publish",
    "webidl": "tsx scripts/webidl-coverage.ts",
    "webidl:list": "tsx scripts/webidl-coverage.ts --list",
    "webidl:json": "tsx scripts/webidl-coverage.ts --json",
    "webidl:generate": "tsx scripts/webidl-coverage.ts --generate",
    "typecheck": "tsc --noEmit",
    "bench:component-vrt": "moon -C benchmarks bench -p mizchi/crater-benchmarks/component_vrt --target js",
    "bench:component-vrt:update-baseline": "node benchmarks/scripts/component-vrt-bench-baseline.mjs update",
    "bench:component-vrt:check-baseline": "node benchmarks/scripts/component-vrt-bench-baseline.mjs check",
    "bench:crater-cli": "node benchmarks/scripts/crater-cli-bench-baseline.mjs print",
    "bench:crater-cli:update-baseline": "node benchmarks/scripts/crater-cli-bench-baseline.mjs update",
    "bench:crater-cli:check-baseline": "node benchmarks/scripts/crater-cli-bench-baseline.mjs check",
    "test:all": "pnpm test:vitest && pnpm test:node",
    "test:vitest": "vitest run --config vitest.config.ts",
    "test:node": "node --test js/test/copy-dist.test.mjs js/test/yoga-api.test.mjs wasm/test/component.test.mjs browser/scripts/mizchi-v8-consumer-prebuild.test.mjs browser/scripts/run-rolldown.test.mjs browser/tests/crater-cli.test.mjs benchmarks/tests/ab-bench.test.mjs benchmarks/tests/component-vrt-bench-baseline.test.mjs benchmarks/tests/crater-cli-bench-baseline.test.mjs scripts/find-dead-mbt-packages.test.mjs scripts/moon-publish-workspace.test.mjs scripts/prefetch-rusty-v8-source-binding.test.mjs scripts/public-api-boundary.test.mjs",
    "test:component-vrt:baseline": "node --test benchmarks/tests/component-vrt-bench-baseline.test.mjs",
    "test:crater-cli:baseline": "node --test benchmarks/tests/crater-cli-bench-baseline.test.mjs",
    "test:bidi-e2e": "playwright test tests/bidi-e2e.test.ts",
    "test:preact": "playwright test tests/preact-compat.test.ts tests/preact-package.test.ts",
    "test:playwright": "playwright test tests/playwright-adapter.test.ts tests/crater-playwright-adapter.test.ts tests/playwright-adapter-user-scenarios.test.ts tests/playwright-adapter-chromium-parity.test.ts",
    "test:vrt": "playwright test tests/paint-vrt.test.ts",
    "gen:paint-vrt-reference": "PAINT_VRT_REFRESH_REFERENCE_FIXTURES=1 playwright test tests/paint-vrt.test.ts",
    "gen:wpt-vrt-reference": "WPT_VRT_REFRESH_REFERENCE_FIXTURES=1 playwright test tests/wpt-vrt.test.ts",
    "test:wpt-vrt": "playwright test tests/wpt-vrt.test.ts",
    "bench:playwright": "playwright test tests/playwright-benchmark.test.ts",
    "bench:realworld": "tsx scripts/real-world-paint-bench.ts",
    "capture:realworld": "tsx scripts/capture-real-world-snapshot.ts",
    "vrt:component": "node --import tsx scripts/component-vrt.ts",
    "vrt:luna-reference": "node --import tsx scripts/luna-vrt-reference.ts",
    "calc:diff": "tsx scripts/calc-layout-diff.ts",
    "match-rate": "tsx scripts/real-world-match-rate.ts",
    "webmcp:model": "tsx scripts/webmcp-openrouter-demo.ts",
    "webmcp:openrouter": "tsx scripts/webmcp-openrouter-demo.ts --provider openrouter",
    "smoke:crater-playwright": "tsx scripts/crater-playwright-smoke.ts",
    "test:website": "playwright test tests/website-loading.test.ts tests/browser-user-scenarios.test.ts"
  },
  "dependencies": {
    "pngjs": "^7.0.0",
    "puppeteer": "^25.16.0"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "^1.41.0",
    "@mizchi/flaker": "0.15.0",
    "@playwright/test": "^1.65.0",
    "@types/ws": "^8.18.2",
    "opentype.js": "^2.0.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.0",
    "preact": "^11.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "webidl2": "^24.5.0",
    "ws": "^8.22.2"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  }
}
