name = "mizchi/crater-js"

version = "0.19.2"

import {
  "mizchi/crater-core@0.19.2",
  "mizchi/crater-aomx@0.19.2",
  "mizchi/css@0.8.0",
  "mizchi/crater-dom@0.19.2",
  "mizchi/crater-layout@0.19.2",
  "mizchi/crater-painter@0.19.2",
  "mizchi/crater-renderer@0.19.2",
  "mizchi/gfx@0.1.1",
}

readme = "README.md"

repository = "https://github.com/mizchi/crater"

license = "Apache-2.0"

description = "JavaScript bindings and compatibility facade for crater"

preferred_target = "js"
